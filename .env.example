# Required for live character research (the Gemini-powered "AI research
# engine" feature — see api/research.ts and RESEARCH.md). Get a key at
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional — override if the default model below gets deprecated.
# Check https://ai.google.dev/gemini-api/docs/models for current model IDs.
GEMINI_MODEL=gemini-2.5-flash

# Not currently wired into the UI — reserved if you upgrade the Arena's
# analysis engine to LLM-written prose later (see ARENA.md).
ANTHROPIC_API_KEY=
